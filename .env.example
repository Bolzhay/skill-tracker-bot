BOT_TOKEN=your_telegram_bot_token_here
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional second model provider: Google's Gemini API. Its free tier is far
# roomier than OpenRouter's 50 requests a day (gemma: 14,400 a day). Create the
# key at https://aistudio.google.com/apikey in a project WITHOUT a billing
# account: a billed project answers 402 once its prepaid credits run out.
GEMINI_API_KEY=

# Optional: a YouTube Data API v3 key (Google Cloud console, APIs & Services, Credentials)
# so /hint can attach real video links. Free: 100 searches a day per project.
# Restrict the key to the YouTube Data API v3 only.
YOUTUBE_API_KEY=

# One-time activation code: the owner sends "/claim <code>" to the bot once.
# Any long random string, e.g.: python -c "import secrets; print(secrets.token_urlsafe(12))"
CLAIM_CODE=

# Optional (defaults shown)
TZ_OFFSET_HOURS=5
WHISPER_MODEL=small
